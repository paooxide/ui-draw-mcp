{
  "autonomous_with_scope_lists": {
    "effective": {
      "browser": {
        "allow_private": false,
        "allowed_origins": []
      },
      "credentials": {
        "allowed_services": []
      },
      "demo": {
        "enabled": false,
        "speed": "demo"
      },
      "fs": {
        "roots": [
          "/tmp/work"
        ]
      },
      "http": {
        "allowed_origins": [],
        "enabled": false,
        "token": "(generated per session)"
      },
      "input": {
        "foreground": "allow",
        "human_override": true,
        "human_override_grace_ms": 1500,
        "human_override_px": 12,
        "polite_idle_ms": 1500,
        "polite_max_wait_ms": 15000,
        "terminal_apps": [
          "Terminal",
          "iTerm",
          "Warp",
          "Alacritty",
          "kitty",
          "Ghostty",
          "WezTerm",
          "Hyper",
          "Tabby",
          "Code",
          "Visual Studio Code",
          "VSCodium",
          "Cursor",
          "Windsurf",
          "Zed",
          "Sublime Text",
          "JetBrains",
          "IntelliJ",
          "PyCharm",
          "WebStorm",
          "RustRover",
          "Xcode",
          "Nova",
          "Emacs"
        ]
      },
      "judge": {
        "base_url": "https://api.typesafe.ai",
        "enabled": false,
        "max_state_bytes": 48000,
        "model": "jev-latest",
        "threshold": 0.7,
        "timeout_ms": 4000
      },
      "memory": {
        "max_recipes": 500,
        "store": "<AGENTCTL_DIR>/memory.json"
      },
      "network": {
        "allow_private": false,
        "allowed_hosts": [
          ".example.com"
        ]
      },
      "packages": {
        "allow_arbitrary_source": false,
        "allowed_sources": [],
        "allowlist": [],
        "denylist": []
      },
      "policy": {
        "access": null,
        "allowed_apps": [
          "Terminal",
          "Finder",
          "TextEdit"
        ],
        "anonymize": false,
        "audit_dir": "<AGENTCTL_DIR>/audit",
        "audit_signing_key": null,
        "categories": [
          "vision",
          "terminal",
          "filesystem",
          "network"
        ],
        "enable": [
          "power_control"
        ],
        "kill_switch_file": "<AGENTCTL_DIR>/STOP",
        "max_consent_prompts": 20,
        "max_denials": 5,
        "mode": "autonomous"
      },
      "terminal": {
        "allow_shell": false,
        "allowed_commands": [
          "git",
          "ls"
        ],
        "allowed_shells": [
          "/bin/zsh",
          "/bin/bash",
          "/bin/sh"
        ],
        "max_pty_buffer": 262144,
        "max_pty_sessions": 4
      }
    },
    "extra": {
      "active_role": null,
      "invariants": {
        "denied_domains": [],
        "protected_paths": [
          "/etc/shadow",
          "/etc/sudoers",
          "/etc/pam.d",
          "/System",
          "/private/etc/master.passwd",
          "/etc/master.passwd"
        ]
      },
      "role_profile": null,
      "roles": {}
    }
  },
